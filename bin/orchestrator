#!/usr/bin/env python3
"""orchestrator: run role-specific coding agents in Herdr.

The root agent stays in the caller pane, TASKS.md renders in a Tasks pane that
takes the right 40% of the caller's tab, and every subagent runs in one shared
`agents` tab. Results come back as files; Herdr state never proves completion.
"""

import argparse
import fcntl
import json
import os
import secrets
import shlex
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path(__file__).resolve().parent.parent
STATE_DIR = ".orchestrator"
AGENTS_TAB = "agents"
TASKS_LABEL = "Tasks"
TASKS_FILE = "TASKS.md"
TASKS_START = "<!-- orchestrator:tasks:start -->"
TASKS_END = "<!-- orchestrator:tasks:end -->"
# The caller keeps this share of the width; the Tasks pane gets the rest (40%).
TASKS_RATIO = "0.6"
MAX_CONSULTS = 3
DEFAULT_TIMEOUT_MIN = 30
CONSULT_TIMEOUT_MIN = 15
START_TIMEOUT_MS = 60000
POLL_SECONDS = 2.0
KINDS = ("claude", "codex", "pi")
SHELLS = {"sh", "bash", "zsh", "fish", "dash", "ksh", "nu"}
READ_ONLY_TOOLS = {"claude": "Read,Grep,Glob", "pi": "read,grep,find,ls"}
COMMANDS = ("start", "dispatch", "wait", "consult", "status", "read", "close", "tasks-pane", "roles")


class OrchestratorError(Exception):
    pass


class HerdrError(OrchestratorError):
    def __init__(self, args, message):
        self.code = _error_code(message)
        super().__init__(f"herdr {shlex.join(args)} failed: {message}")


def _error_code(message):
    try:
        data = json.loads(message)
    except ValueError:
        return None
    err = data.get("error", data) if isinstance(data, dict) else {}
    return err.get("code") if isinstance(err, dict) else None


class Herdr:
    """Thin wrapper over the herdr CLI. In dry-run mode it only prints calls."""

    def __init__(self, dry=False):
        self.dry = dry
        self.calls = 0

    def __call__(self, *args):
        args = [str(a) for a in args]
        if self.dry:
            print("+ herdr " + shlex.join(args), file=sys.stderr)
            return self._dry_response(args)
        proc = subprocess.run(["herdr", *args], capture_output=True, text=True)
        if proc.returncode != 0:
            raise HerdrError(args, (proc.stderr or proc.stdout).strip())
        text = proc.stdout.strip()
        if not text:
            return {}
        try:
            return json.loads(text)
        except ValueError:
            return {"raw": proc.stdout}

    def _dry_response(self, args):
        self.calls += 1
        pane = {"pane_id": f"<pane-{self.calls}>"}
        key = tuple(args[:2])
        if key == ("pane", "split"):
            return {"result": {"pane": pane}}
        if key == ("tab", "create"):
            return {"result": {"tab": {"tab_id": f"<tab-{self.calls}>"}, "root_pane": pane}}
        if key == ("pane", "list"):
            return {"result": {"panes": []}}
        if key == ("tab", "list"):
            return {"result": {"tabs": []}}
        return {"result": {}}


# ---------------------------------------------------------------- context

def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def herdr_context(dry):
    if os.environ.get("HERDR_ENV") != "1":
        if dry:
            return "<caller-pane>", "<workspace>"
        raise OrchestratorError("not running inside a Herdr pane (HERDR_ENV is not 1)")
    pane = os.environ.get("HERDR_PANE_ID")
    workspace = os.environ.get("HERDR_WORKSPACE_ID")
    if not pane or not workspace:
        raise OrchestratorError("HERDR_PANE_ID or HERDR_WORKSPACE_ID is missing")
    return pane, workspace


def checkout_root(cwd):
    proc = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True)
    if proc.returncode == 0 and proc.stdout.strip():
        return Path(proc.stdout.strip()).resolve()
    return Path(cwd).resolve()


def same_path(a, b):
    return bool(a) and os.path.realpath(str(a)) == os.path.realpath(str(b))


def state_dir(root, dry=False):
    path = root / STATE_DIR
    # A cloned repo could ship these as symlinks; never write through them.
    for p in (path, path / "tasks"):
        if p.is_symlink():
            raise OrchestratorError(f"{p} is a symlink; refusing to write through it")
        if p.exists() and not p.is_dir():
            raise OrchestratorError(f"{p} is not a directory")
    if not dry and not path.exists():
        path.mkdir(mode=0o700)
        (path / ".gitignore").write_text("*\n")
    return path


# ------------------------------------------------------------------ roles

def load_roles():
    path = Path(os.environ.get("ORCHESTRATOR_ROLES", HOME / "roles.json"))
    try:
        roles = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise OrchestratorError(f"cannot read roles file {path}: {exc}")
    for name, role in roles.items():
        if role.get("kind") not in KINDS:
            raise OrchestratorError(f"role {name}: kind must be one of {', '.join(KINDS)}")
        if role.get("mode", "headless") not in ("headless", "interactive"):
            raise OrchestratorError(f"role {name}: mode must be headless or interactive")
        if role.get("access", "read-only") not in ("read-only", "write"):
            raise OrchestratorError(f"role {name}: access must be read-only or write")
    return roles


def resolve_role(roles, name, args):
    if name not in roles:
        raise OrchestratorError(f"unknown role {name!r}; known: {', '.join(roles)}")
    role = dict(roles[name], name=name)
    for key in ("kind", "model", "effort", "mode"):
        value = getattr(args, key, None)
        if value:
            role[key] = value
    if getattr(args, "kind", None) and not getattr(args, "model", None):
        # A different CLI cannot reuse the configured model name.
        role.pop("model", None)
        role.pop("advisor", None)
    if role["kind"] != "claude":
        role.pop("advisor", None)
    return role


def role_text(name):
    path = HOME / "roles" / f"{name}.md"
    return path.read_text() if path.exists() else ""


def skill_body():
    """Root agent instructions: the orchestrator skill without its frontmatter."""
    text = (HOME / "skills" / "orchestrator" / "SKILL.md").read_text()
    if text.startswith("---\n"):
        end = text.find("\n---\n", 4)
        if end != -1:
            text = text[end + len("\n---\n"):]
    return text.lstrip()


# ------------------------------------------------------------ agent argv

def agent_argv(role, cwd, prompt=None, result=None, instructions=None):
    """Native CLI argv for a role. Headless roles get the prompt now."""
    kind = role["kind"]
    model, effort = role.get("model"), role.get("effort")
    headless = role.get("mode", "headless") == "headless"
    read_only = role.get("access", "read-only") == "read-only"

    if kind == "claude":
        argv = ["claude"]
        if headless:
            argv += ["-p", prompt]
        if model:
            argv += ["--model", model]
        if effort:
            argv += ["--effort", effort]
        if role.get("advisor"):
            argv += ["--advisor", role["advisor"]]
        if instructions:
            argv += ["--append-system-prompt", instructions]
        if read_only:
            tools = READ_ONLY_TOOLS["claude"] + (",WebSearch,WebFetch" if role.get("web") else "")
            argv += ["--tools", tools, "--allowedTools", tools]
        elif headless:
            argv += ["--permission-mode", "acceptEdits"]
        return argv

    if kind == "codex":
        opts = []
        if model:
            opts += ["-m", model]
        if effort:
            opts += ["-c", f"model_reasoning_effort={effort}"]
        if instructions:
            opts += ["-c", "developer_instructions=" + json.dumps(instructions)]
        opts += ["-s", "read-only" if read_only else "workspace-write", "-C", str(cwd)]
        if headless:
            return ["codex", "exec", *opts, "--skip-git-repo-check", "-o", str(result), prompt]
        return ["codex", *opts, "-a", "on-request"]

    argv = ["pi"]
    if headless:
        argv += ["-p", "--no-session"]
    if model:
        argv += ["--model", model]
    if effort:
        argv += ["--thinking", effort]
    if instructions:
        argv += ["--append-system-prompt", instructions]
    if read_only:
        argv += ["--tools", READ_ONLY_TOOLS["pi"]]
    if headless:
        argv.append(prompt)
    return argv


# ------------------------------------------------------------- Tasks pane

def tasks_command(root):
    # Run the wait loop in a child shell so the pane's own shell never looks idle.
    script = 'until [ -f "$1" ]; do sleep 1; done; exec glow -t "$1"'
    return f"sh -c {shlex.quote(script)} tasks {shlex.quote(str(root / TASKS_FILE))}"


def pane_is_idle_shell(h, pane_id):
    try:
        info = h("pane", "process-info", "--pane", pane_id)
    except HerdrError:
        return False
    info = info.get("result", {}).get("process_info", {})
    procs = info.get("foreground_processes") or []
    shell_pid = info.get("shell_pid")
    if not procs:
        return False
    if shell_pid is not None:
        return all(p.get("pid") == shell_pid for p in procs)
    names = {Path(p.get("name") or p.get("argv0") or "").name.lstrip("-") for p in procs}
    return names <= SHELLS


def open_tasks_pane(h, root, caller, workspace):
    panes = h("pane", "list", "--workspace", workspace).get("result", {}).get("panes", [])
    for pane in panes:
        if pane.get("label") == TASKS_LABEL and same_path(pane.get("cwd"), root):
            pane_id = pane["pane_id"]
            if pane_is_idle_shell(h, pane_id):
                h("pane", "run", pane_id, tasks_command(root))
                return {"status": "restarted", "pane": pane_id}
            return {"status": "reused", "pane": pane_id}
    res = h("pane", "split", "--pane", caller, "--direction", "right", "--ratio", TASKS_RATIO,
            "--cwd", root, "--no-focus")
    pane_id = res["result"]["pane"]["pane_id"]
    h("pane", "rename", pane_id, TASKS_LABEL)
    h("pane", "run", pane_id, tasks_command(root))
    return {"status": "opened", "pane": pane_id}


# ------------------------------------------------------------- agents tab

def env_flags(env):
    flags = []
    for key, value in env.items():
        flags += ["--env", f"{key}={value}"]
    return flags


def agents_pane(h, workspace, cwd, env):
    """Return a fresh shell pane in the agents tab, creating the tab if needed."""
    tabs = h("tab", "list", "--workspace", workspace).get("result", {}).get("tabs", [])
    tab_id = next((t["tab_id"] for t in tabs if t.get("label") == AGENTS_TAB), None)
    panes = []
    if tab_id is not None:
        panes = [p for p in h("pane", "list", "--workspace", workspace)["result"]["panes"]
                 if p.get("tab_id") == tab_id]
    if not panes:
        res = h("tab", "create", "--workspace", workspace, "--cwd", cwd, "--label", AGENTS_TAB,
                "--no-focus", *env_flags(env))
        return res["result"]["tab"]["tab_id"], res["result"]["root_pane"]["pane_id"]
    rects = h("pane", "layout", "--pane", panes[0]["pane_id"])["result"]["layout"]["panes"]
    target = max(rects, key=lambda p: p["rect"]["width"] * p["rect"]["height"])
    rect = target["rect"]
    # Terminal cells are about twice as tall as wide, so 2.5x width reads as wide.
    direction = "right" if rect["width"] >= rect["height"] * 2.5 else "down"
    res = h("pane", "split", "--pane", target["pane_id"], "--direction", direction, "--cwd", cwd,
            "--no-focus", *env_flags(env))
    return tab_id, res["result"]["pane"]["pane_id"]


# ---------------------------------------------------------- task records

def task_dir_for(root, task):
    return root / STATE_DIR / "tasks" / task


def load_meta(root, task):
    path = task_dir_for(root, task) / "meta.json"
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        raise OrchestratorError(f"no task {task!r} under {root / STATE_DIR}")


def save_meta(meta):
    meta["updated"] = now()
    path = Path(meta["dir"]) / "meta.json"
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(meta, indent=2) + "\n")
    tmp.replace(path)
    root = Path(meta["dir"]).parents[2]
    try:
        sync_tasks_file(root)
    except (OSError, OrchestratorError) as exc:
        # TASKS.md is a view; a failed update never changes the task outcome.
        print(f"orchestrator: warning: {TASKS_FILE} not updated: {exc}", file=sys.stderr)


def load_metas(root):
    metas = []
    for path in sorted((root / STATE_DIR / "tasks").glob("*/meta.json")):
        try:
            metas.append(json.loads(path.read_text()))
        except (OSError, ValueError):
            continue
    return sorted(metas, key=lambda m: m.get("started", ""))


# ------------------------------------------------------------- TASKS.md

def tasks_section(root):
    lines = [TASKS_START, "## Dispatched tasks", "",
             "| Task | Role | Agent | Status | Updated | Result |", "|---|---|---|---|---|---|"]
    for m in load_metas(root):
        agent = " ".join(str(m[k]) for k in ("kind", "model", "effort") if m.get(k))
        updated = (m.get("updated") or m.get("started") or "")[5:16].replace("T", " ")
        result = "-"
        if Path(m["result"]).is_file():
            result = f"[result]({os.path.relpath(m['result'], root)})"
        lines.append(f"| {m['task']} | {m['role']} | {agent} | {m.get('status', '?')} | {updated} | {result} |")
    lines.append(TASKS_END)
    return "\n".join(lines) + "\n"


def merge_tasks_section(text, section):
    start, end = text.find(TASKS_START), text.find(TASKS_END)
    if start != -1 and end > start:
        after = text[end + len(TASKS_END):]
        return text[:start] + section + (after[1:] if after.startswith("\n") else after)
    base = text.rstrip("\n")
    return (base + "\n\n" if base else "# Tasks\n\n") + section


def sync_tasks_file(root):
    """Rewrite the orchestrator-owned section of TASKS.md from the task records."""
    path = root / TASKS_FILE
    if path.is_symlink():
        raise OrchestratorError(f"{path} is a symlink; not following it")
    if path.exists() and not path.is_file():
        raise OrchestratorError(f"{path} is not a regular file")
    # O_NOFOLLOW and no O_TRUNC: a planted symlink fails instead of being emptied.
    lock_fd = os.open(root / STATE_DIR / "tasks.lock", os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        for _ in range(3):
            before = path.stat() if path.exists() else None
            text = path.read_text() if before else ""
            new = merge_tasks_section(text, tasks_section(root))
            if new == text:
                return
            fd, tmp = tempfile.mkstemp(dir=root, prefix=f".{TASKS_FILE}.", suffix=".tmp")
            with os.fdopen(fd, "w") as handle:
                handle.write(new)
            # mkstemp creates 0600; keep the existing mode, or the umask default for a new file.
            if before:
                os.chmod(tmp, before.st_mode & 0o777)
            else:
                umask = os.umask(0)
                os.umask(umask)
                os.chmod(tmp, 0o666 & ~umask)
            after = path.stat() if path.exists() else None
            # Replace only if nobody (e.g. the root agent) edited TASKS.md meanwhile.
            if (before is None and after is None) or (
                    before and after and (before.st_mtime_ns, before.st_size) == (after.st_mtime_ns, after.st_size)):
                os.replace(tmp, path)
                return
            os.unlink(tmp)
    finally:
        os.close(lock_fd)
    raise OrchestratorError(f"{path} kept changing during the update")


def new_task_id(role, requested):
    if requested:
        if not all(c.isalnum() or c in "._-" for c in requested) or not requested[0].isalnum():
            raise OrchestratorError("task id may contain only letters, digits, '.', '_' and '-'")
        return requested
    return f"{role}-{time.strftime('%m%d-%H%M%S')}-{secrets.token_hex(2)}"


def compose_prompt(role, task, brief_text, result, headless):
    if headless:
        output = "Your final message is saved verbatim as the result file. Make it the complete result document."
    else:
        output = (f"When finished, write the complete result document as Markdown to `{result}`, "
                  "then stop and wait.")
        if role.get("access") == "write":
            output += (f"\n\nFor a second opinion mid-task run `{HOME / 'bin' / 'orchestrator'} consult "
                       f"\"<question>\"` (at most {MAX_CONSULTS} per task).")
    return "\n\n".join([
        f"# Task {task}: {role['name']}",
        role_text("common").strip(),
        role_text(role["name"]).strip(),
        "## Output\n\n" + output,
        "## Brief\n\n" + brief_text.strip(),
    ]) + "\n"


def run_script(meta, argv):
    cmd = shlex.join(argv)
    if meta["kind"] != "codex":
        cmd += " > " + shlex.quote(meta["result"])
    exit_file = shlex.quote(str(Path(meta["dir"]) / "exit"))
    label = f"{meta['role']} {meta['task']}: {meta['kind']} {meta.get('model') or ''} {meta.get('effort') or ''}"
    return "\n".join([
        "#!/bin/sh",
        f"cd {shlex.quote(meta['cwd'])} || exit 1",
        f"echo {shlex.quote('orchestrator: ' + label.strip())}",
        cmd,
        "code=$?",
        f"printf '%s\\n' \"$code\" > {exit_file}",
        f"echo \"orchestrator: exit $code, result {meta['result']}\"",
        "",
    ])


def result_ready(meta):
    path = Path(meta["result"])
    return path.is_file() and path.stat().st_size > 0


# --------------------------------------------------------------- waiting

def wait_headless(meta, timeout_s):
    exit_file = Path(meta["dir"]) / "exit"
    deadline = time.monotonic() + timeout_s
    while not exit_file.exists():
        if time.monotonic() >= deadline:
            return "timeout"
        time.sleep(POLL_SECONDS)
    code = exit_file.read_text().strip()
    meta["exit_code"] = int(code) if code.lstrip("-").isdigit() else code
    if meta["exit_code"] != 0:
        return "failed"
    return "done" if result_ready(meta) else "no_result"


def agent_status(h, name):
    try:
        info = h("agent", "get", name)
    except HerdrError:
        return None
    return info.get("result", {}).get("agent", {}).get("agent_status")


def settle_interactive(h, meta):
    if result_ready(meta):
        return "done"
    return "blocked" if agent_status(h, meta["name"]) == "blocked" else "no_result"


def wait_interactive(h, meta, timeout_s):
    try:
        h("agent", "wait", meta["name"], "--timeout", int(timeout_s * 1000))
    except HerdrError as exc:
        if exc.code == "timeout" or "timeout" in str(exc).lower():
            return "timeout"
        raise
    return settle_interactive(h, meta)


def finish(h, meta, status, keep_pane):
    meta["status"] = status
    if status != "running":
        meta["finished"] = now()
    if (status == "done" and meta["mode"] == "headless" and not keep_pane
            and not meta.get("pane_closed")):
        try:
            h("pane", "close", meta["pane"])
            meta["pane_closed"] = True
        except HerdrError:
            pass
    save_meta(meta)
    return meta


def report(meta):
    keys = ("task", "role", "status", "kind", "model", "effort", "advisor", "mode", "name",
            "pane", "result", "exit_code", "dir")
    print(json.dumps({k: meta[k] for k in keys if meta.get(k) is not None}, indent=2))
    return 0 if meta["status"] in ("done", "running") else 1


# -------------------------------------------------------------- commands

def cmd_dispatch(args):
    if os.environ.get("ORCHESTRATOR_DEPTH"):
        raise OrchestratorError("subagents may not dispatch; use `orchestrator consult` instead")
    roles = load_roles()
    role = resolve_role(roles, args.role, args)
    if args.role in ("orchestrator", "consultant"):
        raise OrchestratorError(f"role {args.role} cannot be dispatched")
    brief = Path(args.brief)
    try:
        brief_text = brief.read_text()
    except OSError as exc:
        raise OrchestratorError(f"cannot read brief {brief}: {exc}")
    if not brief_text.strip():
        raise OrchestratorError(f"brief {brief} is empty")

    h = Herdr(args.dry_run)
    caller, workspace = herdr_context(args.dry_run)
    cwd = Path.cwd().resolve()
    root = checkout_root(cwd)
    state_dir(root, dry=True)
    task = new_task_id(args.role, args.task)
    tdir = task_dir_for(root, task)
    if tdir.exists():
        raise OrchestratorError(f"task {task} already exists; use a new task id for a retry")
    headless = role.get("mode", "headless") == "headless"
    meta = {
        "task": task, "role": args.role, "kind": role["kind"], "model": role.get("model"),
        "effort": role.get("effort"), "advisor": role.get("advisor"),
        "mode": role.get("mode", "headless"), "access": role.get("access", "read-only"),
        "name": f"{args.role[:11]}-{secrets.token_hex(3)}", "cwd": str(cwd), "dir": str(tdir),
        "brief": str(brief.resolve()), "result": str(tdir / "result.md"),
        "caller": caller, "started": now(), "status": "starting",
    }
    prompt_file = tdir / "prompt.md"
    short_prompt = f"Read and follow {prompt_file}."
    argv = agent_argv(role, cwd, prompt=short_prompt, result=meta["result"])
    env = {"ORCHESTRATOR_DEPTH": "1", "ORCHESTRATOR_TASK": task, "ORCHESTRATOR_TASK_DIR": str(tdir)}

    if args.dry_run:
        print("+ " + shlex.join(argv), file=sys.stderr)
        agents_pane(h, workspace, cwd, env)
        print(json.dumps(dict(meta, status="dry-run"), indent=2))
        return 0

    state_dir(root)
    tdir.mkdir(parents=True, mode=0o700)
    (tdir / "brief.md").write_text(brief_text)
    prompt_file.write_text(compose_prompt(role, task, brief_text, meta["result"], headless))
    save_meta(meta)

    try:
        meta["tab"], meta["pane"] = agents_pane(h, workspace, cwd, env)
    except OrchestratorError as exc:
        meta["error"] = str(exc)
        finish(h, meta, "failed", True)
        raise
    save_meta(meta)
    h("pane", "rename", meta["pane"], f"{args.role} {task}")
    timeout_s = args.timeout_min * 60

    if headless:
        script = tdir / "run.sh"
        script.write_text(run_script(meta, argv))
        h("pane", "run", meta["pane"], "sh " + shlex.quote(str(script)))
        meta["status"] = "running"
        save_meta(meta)
        if args.no_wait:
            return report(meta)
        return report(finish(h, meta, wait_headless(meta, timeout_s), args.keep_pane))

    try:
        h("agent", "start", meta["name"], "--kind", role["kind"], "--pane", meta["pane"],
          "--timeout", START_TIMEOUT_MS, "--", *argv[1:])
    except HerdrError as exc:
        if exc.code == "agent_not_ready":
            return report(finish(h, meta, "blocked", True))
        meta["error"] = str(exc)
        finish(h, meta, "failed", True)
        raise
    meta["status"] = "running"
    save_meta(meta)
    prompt_args = ["agent", "prompt", meta["name"], short_prompt]
    if args.no_wait:
        h(*prompt_args)
        return report(meta)
    try:
        h(*prompt_args, "--wait", "--timeout", int(timeout_s * 1000))
    except HerdrError as exc:
        if exc.code == "agent_blocked":
            return report(finish(h, meta, "blocked", True))
        if exc.code in ("timeout", "agent_prompt_stalled"):
            return report(finish(h, meta, "timeout", True))
        raise
    return report(finish(h, meta, settle_interactive(h, meta), True))


def cmd_wait(args):
    h = Herdr()
    root = checkout_root(Path.cwd())
    meta = load_meta(root, args.task)
    if meta.get("status") not in ("running", "timeout", "blocked", "no_result"):
        return report(meta)
    timeout_s = args.timeout_min * 60
    if meta["mode"] == "headless":
        status = wait_headless(meta, timeout_s)
    else:
        status = wait_interactive(h, meta, timeout_s)
    return report(finish(h, meta, status, args.keep_pane))


def cmd_status(args):
    root = checkout_root(Path.cwd())
    metas = load_metas(root)
    if args.json:
        print(json.dumps(metas, indent=2))
        return 0
    if not metas:
        print("no tasks")
        return 0
    rows = [("TASK", "ROLE", "STATUS", "AGENT", "PANE", "RESULT")]
    for m in metas:
        agent = " ".join(str(m.get(k)) for k in ("kind", "model", "effort") if m.get(k))
        pane = "closed" if m.get("pane_closed") else m.get("pane", "-")
        rows.append((m["task"], m["role"], m.get("status", "?"), agent, pane,
                     os.path.relpath(m["result"], root)))
    print_table(rows)
    return 0


def cmd_read(args):
    root = checkout_root(Path.cwd())
    meta = load_meta(root, args.task)
    if meta.get("pane_closed") or not meta.get("pane"):
        raise OrchestratorError(f"pane for task {args.task} is closed; see {meta['result']}")
    out = Herdr()("pane", "read", meta["pane"], "--source", "recent-unwrapped",
                  "--lines", args.lines)
    sys.stdout.write(out.get("raw") or json.dumps(out, indent=2) + "\n")
    return 0


def cmd_close(args):
    root = checkout_root(Path.cwd())
    meta = load_meta(root, args.task)
    if meta.get("pane_closed") or not meta.get("pane"):
        print(f"pane for task {args.task} is already closed")
        return 0
    if meta.get("status") == "running" and not args.force:
        raise OrchestratorError(f"task {args.task} is still running; pass --force to close it")
    try:
        Herdr()("pane", "close", meta["pane"])
    except HerdrError as exc:
        if exc.code != "pane_not_found":
            raise
    meta["pane_closed"] = True
    save_meta(meta)
    print(f"closed {meta['pane']} ({args.task})")
    return 0


def cmd_consult(args):
    if os.environ.get("ORCHESTRATOR_CONSULT"):
        raise OrchestratorError("consult cannot be nested")
    roles = load_roles()
    role = resolve_role(roles, args.role, args)
    if role.get("access", "read-only") != "read-only":
        raise OrchestratorError(f"consult needs a read-only role; {args.role} can write")
    role["mode"] = "headless"
    task_dir = os.environ.get("ORCHESTRATOR_TASK_DIR")
    counter = Path(task_dir) / "consults" if task_dir else None
    used = int(counter.read_text()) if counter and counter.exists() else 0
    if used >= MAX_CONSULTS:
        raise OrchestratorError(f"consult limit reached ({MAX_CONSULTS} per task)")

    question = " ".join(args.question).strip()
    if not question:
        raise OrchestratorError("consult needs a question")
    context = ""
    if args.files:
        context = "\n\nRelevant files (read them as needed): " + ", ".join(args.files)
    prompt = role_text(args.role).strip() + "\n\n## Question\n\n" + question + context
    cwd = Path.cwd().resolve()
    with tempfile.TemporaryDirectory() as tmp:
        result = Path(tmp) / "answer.md"
        argv = agent_argv(role, cwd, prompt=prompt, result=result)
        if args.dry_run:
            print("+ " + shlex.join(argv), file=sys.stderr)
            return 0
        if counter:
            counter.write_text(f"{used + 1}\n")
        env = dict(os.environ, ORCHESTRATOR_CONSULT="1")
        try:
            proc = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True,
                                  stdin=subprocess.DEVNULL, timeout=args.timeout_min * 60)
        except subprocess.TimeoutExpired:
            raise OrchestratorError(f"consult timed out after {args.timeout_min} min")
        answer = result.read_text() if role["kind"] == "codex" and result.exists() else proc.stdout
    if proc.returncode != 0:
        raise OrchestratorError(f"consult failed (exit {proc.returncode}): {proc.stderr.strip()[-500:]}")
    if task_dir:
        with open(Path(task_dir) / "consults.md", "a") as log:
            log.write(f"## {now()} {args.role}\n\nQ: {question}\n\n{answer.strip()}\n\n")
    print(answer.strip())
    return 0


def cmd_tasks_pane(args):
    h = Herdr(args.dry_run)
    caller, workspace = herdr_context(args.dry_run)
    root = checkout_root(Path.cwd())
    print(json.dumps(open_tasks_pane(h, root, caller, workspace)))
    return 0


def cmd_start(args):
    roles = load_roles()
    role = resolve_role(roles, "orchestrator", args)
    role.update(mode="interactive", access="write")
    cwd = Path.cwd().resolve()
    argv = agent_argv(role, cwd, instructions=skill_body()) + list(args.extra or [])
    if not args.no_tasks_pane:
        h = Herdr(args.dry_run)
        caller, workspace = herdr_context(args.dry_run)
        try:
            print(json.dumps(open_tasks_pane(h, checkout_root(cwd), caller, workspace)))
        except OrchestratorError as exc:
            # The Tasks pane is a convenience; never block the root agent on it.
            print(f"warning: Tasks pane not opened: {exc}", file=sys.stderr)
    if args.dry_run:
        print("+ " + shlex.join(argv), file=sys.stderr)
        return 0
    os.execvp(argv[0], argv)
    return 0


def cmd_roles(args):
    roles = load_roles()
    rows = [("ROLE", "KIND", "MODEL", "EFFORT", "ADVISOR", "MODE", "ACCESS")]
    for name, r in roles.items():
        rows.append((name, r["kind"], r.get("model", "-"), r.get("effort", "-"),
                     r.get("advisor", "-"), r.get("mode", "interactive" if name == "orchestrator" else "headless"),
                     r.get("access", "write" if name == "orchestrator" else "read-only")))
    print_table(rows)
    return 0


def print_table(rows):
    widths = [max(len(str(r[i])) for r in rows) for i in range(len(rows[0]))]
    for row in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(row, widths)).rstrip())


# ------------------------------------------------------------------ main

def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--dry-run", action="store_true",
                        help="print the herdr and agent commands without running them")
    overrides = argparse.ArgumentParser(add_help=False)
    overrides.add_argument("--kind", choices=KINDS, help="override the role's CLI")
    overrides.add_argument("--model", help="override the role's model")
    overrides.add_argument("--effort", help="override the role's effort or thinking level")

    parser = argparse.ArgumentParser(prog="orchestrator", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("start", parents=[common, overrides],
                       help="open the Tasks pane and run the root agent here (default)")
    p.add_argument("--no-tasks-pane", action="store_true")
    p.add_argument("extra", nargs=argparse.REMAINDER, help="native args after --")
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("dispatch", parents=[common, overrides], help="run a role on a brief")
    p.add_argument("role")
    p.add_argument("--brief", required=True)
    p.add_argument("--task", help="task id (default: generated)")
    p.add_argument("--mode", choices=("headless", "interactive"))
    p.add_argument("--no-wait", action="store_true")
    p.add_argument("--keep-pane", action="store_true", help="keep a finished headless pane open")
    p.add_argument("--timeout-min", type=float, default=DEFAULT_TIMEOUT_MIN)
    p.set_defaults(func=cmd_dispatch)

    p = sub.add_parser("wait", help="wait for a task started with --no-wait")
    p.add_argument("task")
    p.add_argument("--keep-pane", action="store_true")
    p.add_argument("--timeout-min", type=float, default=DEFAULT_TIMEOUT_MIN)
    p.set_defaults(func=cmd_wait)

    p = sub.add_parser("consult", parents=[common, overrides],
                       help="ask a stronger read-only model one question, mid-task")
    p.add_argument("question", nargs="+")
    p.add_argument("--role", default="consultant")
    p.add_argument("--files", nargs="*", default=[])
    p.add_argument("--timeout-min", type=float, default=CONSULT_TIMEOUT_MIN)
    p.set_defaults(func=cmd_consult)

    p = sub.add_parser("status", help="list tasks")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("read", help="print recent output of a task pane")
    p.add_argument("task")
    p.add_argument("--lines", type=int, default=120)
    p.set_defaults(func=cmd_read)

    p = sub.add_parser("close", help="close the pane of a task")
    p.add_argument("task")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_close)

    p = sub.add_parser("tasks-pane", parents=[common], help="open or reuse the Tasks pane")
    p.set_defaults(func=cmd_tasks_pane)

    p = sub.add_parser("roles", help="show the role table")
    p.set_defaults(func=cmd_roles)
    return parser


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    if not argv or (argv[0] not in COMMANDS and argv[0] not in ("-h", "--help")):
        argv = ["start", *argv]
    args = parser.parse_args(argv)
    if getattr(args, "extra", None) and args.extra[:1] == ["--"]:
        args.extra = args.extra[1:]
    try:
        return args.func(args)
    except OrchestratorError as exc:
        print(f"orchestrator: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
